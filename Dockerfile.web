# syntax=docker/dockerfile:1
# Single-container deployment: Node/Nitro + PostgreSQL, native HTTPS.
ARG NODE_VERSION=20

# ---------- build stage ----------
FROM node:${NODE_VERSION}-bookworm-slim AS build
WORKDIR /app

# Pin the Nitro preset to a Node.js server (self-hosted Docker, native HTTPS/PG).
# Neutralize the Lovable/Supabase VITE_ vars that live in the committed .env so
# they are NOT baked into the client bundle — a self-hosted container must not
# phone home to the Lovable backend. dotenv never overwrites existing process
# env, so these empty values win over the .env file. AUTH_MODE=none makes any
# prerender use the no-auth path instead of requireSupabaseAuth.
ENV NITRO_PRESET=node-server \
    AUTH_MODE=none \
    VITE_SUPABASE_URL="" \
    VITE_SUPABASE_PUBLISHABLE_KEY="" \
    VITE_SUPABASE_PROJECT_ID=""

COPY package.json bun.lock* yarn.lock* package-lock.json* pnpm-lock.yaml* ./
# Install with npm (lockfile-agnostic). Switch to pnpm/bun if your repo uses one.
RUN if [ -f pnpm-lock.yaml ]; then \
      corepack enable && corepack prepare pnpm@latest --activate && pnpm install --frozen-lockfile; \
    elif [ -f yarn.lock ]; then \
      yarn install --frozen-lockfile; \
    elif [ -f bun.lock ]; then \
      npm install -g bun && bun install --frozen-lockfile; \
    else \
      npm ci; \
    fi

COPY . .

# Build the TanStack Start app into a Nitro node-server output.
# AUTH_MODE and DB_* are runtime vars, so they are NOT baked here; only the
# VITE_ build-time defaults (none needed for local mode) are left unset.
RUN npm run build

# ---------- runtime stage ----------
FROM node:${NODE_VERSION}-bookworm-slim AS runtime
WORKDIR /app

# PostgreSQL + supervisord for single-container orchestration.
RUN apt-get update && apt-get install -y --no-install-recommends \
      postgresql postgresql-contrib supervisor ca-certificates libcap2-bin \
    && rm -rf /var/lib/apt/lists/*

# `pg` is loaded via dynamic require(), which Nitro cannot trace. Install
# only the locked runtime dependencies, independently of the frontend package.
# Installing against the full app manifest previously crashed npm's resolver
# (edgesOut) and needlessly resolved the complete frontend dependency graph.
COPY docker/runtime/package.json docker/runtime/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# App server bundle (runtime dependencies above remain cacheable across builds).
COPY --from=build /app/.output ./.output
# v2.49: the web server runs as this unprivileged user (see supervisord.conf).
# It still listens on 443 inside the container through one file capability on
# the node binary; nothing else about node changes.
RUN useradd --system --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin --uid 10001 tdhweb \
    && setcap 'cap_net_bind_service=+ep' "$(readlink -f "$(command -v node)")"
COPY db/init.sql /app/db/init.sql
# init.sql pulls the card seed in with \ir, so it has to sit next to it.
COPY db/seed_cards.sql /app/db/seed_cards.sql
COPY db/check-bootstrap.sql db/check-schema.sql /app/db/
COPY db/migrations /app/db/migrations
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/warmup.mjs /app/docker/warmup.mjs
COPY docker/bootstrap-db.sh /app/docker/bootstrap-db.sh
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Persistent data: PostgreSQL data dir + uploads
VOLUME ["/var/lib/postgresql/data", "/certs"]

# DB_PASSWORD is deliberately NOT defaulted here. The image used to ship
# DB_PASSWORD=tdh, which quietly defeated the rule that the deployment must set
# it explicitly: the entrypoint's ${DB_PASSWORD:?} was satisfied by the image
# default and every container ran on the same known password. Set it in the
# deployment environment (e.g. /opt/TDH/.env).

ENV NODE_ENV=production \
    PORT=443 \
    DB_HOST=127.0.0.1 \
    DB_PORT=5432 \
    DB_NAME=tdh \
    DB_USER=tdh \
    AUTH_MODE=none \
    NITRO_SSL_CERT=/certs/fullchain.pem \
    NITRO_SSL_KEY=/certs/privkey.pem

EXPOSE 443

ENTRYPOINT ["/entrypoint.sh"]
CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
