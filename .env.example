# TDH - Tacho Data Hub
# Copy to .env and adjust.

# Public URL the app is reached at (http://<ip> for test1/test3)
PUBLIC_BASE_URL=http://localhost

# Domain used for TLS (test2 self-signed CN, test4 Let's Encrypt)
DOMAIN=tdh.example.com

# Contact address for Let's Encrypt (test4)
LETSENCRYPT_EMAIL=you@example.com
