# Tachograph Cards Info Tool — local Docker deployment
# Copy to .env and adjust.

# --- App / runtime ---
# Port the Nitro server listens on inside the container.
PORT=443
# Comma-separated list of origins allowed to call the app (CORS / OAuth redirects).
PUBLIC_BASE_URL=https://tdh.example.com

# Never append a comment after a value in this file: Docker keeps the comment
# text as part of the value. Put explanations on their own line, as done here.

# --- Auth ---
# none  = no Supabase login (required for the self-hosted container). Anything
#         else makes the app take the Supabase path, offer a Sign in it cannot
#         serve, and fail with "Missing Supabase environment variable(s)".
# oidc  = Authentik/OpenID Connect (planned, step 2). Requires OIDC_* vars below.
AUTH_MODE=none

# Gates writing in AUTH_MODE=none. Unset, the instance is read-only; enter the
# same value in the app under Tools to unlock editing. Pick something long.
ADMIN_TOKEN=

# --- Local PostgreSQL ---
# When DB_HOST is set, the app uses a local PostgreSQL database (bundled in the
# container). When unset, it falls back to the Lovable/Supabase backend (preview).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tdh
DB_USER=tdh
# No default: the image ships none on purpose, so a deployment cannot end up
# running on a password everyone knows.
DB_PASSWORD=changeme

# --- HTTPS (Nitro native TLS) ---
# Mount your certs to /certs/fullchain.pem and /certs/privkey.pem (read-only).
# If the files are missing, the server generates a self-signed cert for testing.
NITRO_SSL_CERT=/certs/fullchain.pem
NITRO_SSL_KEY=/certs/privkey.pem
# Optional domain for the self-signed cert CN (test mode).
DOMAIN=tdh.example.com

# --- JRC / TED update checks (outbound HTTPS to ec.europa.eu / ted.europa.eu) ---
# Cron secret shared between pg_cron and the /api/public/jrc-check endpoint.
# Leave empty to disable scheduled checks; the UI "Check for updates" still works.
CRON_SECRET=

# --- OIDC / Authentik (step 2, only when AUTH_MODE=oidc) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
